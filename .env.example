# Copier ce fichier en ".env" (à la racine, à côté de docker-compose.yml)
# puis remplacer les valeurs. Le fichier ".env" réel ne doit jamais être commité.

MYSQL_ROOT_PASSWORD=changeme_root_password
MYSQL_DATABASE=elearning
MYSQL_USER=elearning_user
MYSQL_PASSWORD=changeme_user_password

JWT_SECRET=changeme_long_random_jwt_secret

# Ports exposés côté hôte (Windows)
API_PORT=3000
FRONTEND_PORT=4200
